{
  "manifest_version": 3,
  "name": "AgentBridge",
  "version": "1.0.0",
  "description": "The semantic execution layer that makes the web faster, cheaper, and more reliable for AI agents.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.bundle.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open AgentBridge Side Panel"
  }
}
